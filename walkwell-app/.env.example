# Server
PORT=3000

# Oracle Database connection (thin mode - no Instant Client needed)
# Format: user/password@host:port/service_name
ORACLE_USER=walking_app
ORACLE_PASSWORD=walking_app_pw
ORACLE_CONNECTION_STRING=localhost:1521/FREEPDB1

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# Account lockout policy
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15